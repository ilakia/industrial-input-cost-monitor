# Copy this file to .env and adjust. Never commit .env.
# Values below are placeholders for local development only.

# Where raw files are stored: "local" (a folder) or "minio" (S3-compatible, from Milestone 3)
STORAGE_BACKEND=local
LOCAL_DATA_DIR=data

# Path of the DuckDB database file used by dbt
DUCKDB_PATH=data/warehouse.duckdb
